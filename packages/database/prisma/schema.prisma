generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DEV
  ADMIN
  PARTNER
  BENEFICIARY
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
  OVERDUE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String?  @unique
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  partnerId    String?  @db.Uuid
  partner      Partner? @relation(fields: [partnerId], references: [id])
  financeAttendances FinanceAttendance[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([role])
}

model Partner {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  serviceType     String      @default("Consultas médicas")
  serviceTypes    String[]    @default([])
  services        String      @default("")
  address         String      @default("")
  city            String      @default("")
  phone           String?
  businessHours   String      @default("")
  discountPercent Int         @default(0)
  active          Boolean     @default(true)
  users           User[]
  attendances     Attendance[]
  financeCustomers FinanceCustomer[]
  financeAttendances FinanceAttendance[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([active, name])
}

model Plan {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  active        Boolean       @default(true)
  beneficiaries Beneficiary[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Beneficiary {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  cardNumber  String            @unique
  cpfHash     String?           @unique
  cpfCipher   String?
  status      BeneficiaryStatus @default(ACTIVE)
  planId      String?           @db.Uuid
  plan        Plan?             @relation(fields: [planId], references: [id])
  attendances Attendance[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([status])
}

model Attendance {
  id            String      @id @default(uuid()) @db.Uuid
  beneficiaryId String      @db.Uuid
  partnerId     String      @db.Uuid
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id])
  partner       Partner     @relation(fields: [partnerId], references: [id])
  performedAt   DateTime    @default(now())
  notes         String?
  createdAt     DateTime    @default(now())
  @@index([beneficiaryId, performedAt])
  @@index([partnerId, performedAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([createdAt])
  @@index([entityType, entityId])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum CatalogCategory {
  CONSULTA
  CHECKUP
  EXAME
  PROCEDIMENTO
  TERAPIA
}

model CatalogItem {
  id               String          @id @default(uuid()) @db.Uuid
  importKey        String?         @unique
  name             String
  category         CatalogCategory
  group            String
  professional     String?
  notes            String?
  normalPriceCents Int
  qualiPriceCents  Int
  active           Boolean         @default(true)
  displayOrder     Int             @default(0)
  sourceDocument   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  attendances      FinanceAttendance[]

  @@index([active, category, displayOrder])
  @@index([group])
}

enum FinanceStatus {
  PAID
  OPEN
  EXPECTED
  PENDING
  IN_REVIEW
  AWAITING
  UNSPECIFIED
}

model FinanceCustomer {
  id             String         @id @default(uuid()) @db.Uuid
  birthDate      DateTime?      @db.Date
  importKey      String         @unique
  name           String
  cpfHash        String?
  cpfLast4       String?
  cpfValid       Boolean        @default(false)
  cpfConflict    Boolean        @default(false)
  planType       String?
  amountCents    Int?
  paymentMethod  String?
  paymentDetails String?
  referenceDate  DateTime?      @db.Date
  invoice        String?
  unit           String?        // Nome original importado, mantido para histórico
  partnerId      String?        @db.Uuid
  partner        Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  rawStatus      String?
  status         FinanceStatus  @default(UNSPECIFIED)
  issues         FinanceIssue[]
  attendances    FinanceAttendance[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([name])
  @@index([cpfHash])
  @@index([partnerId])
}

model FinanceIssue {
  id             String         @id @default(uuid()) @db.Uuid
  importKey      String         @unique
  customerId     String?        @db.Uuid
  customer       FinanceCustomer? @relation(fields: [customerId], references: [id])
  name           String
  planType       String?
  amountCents    Int?
  paymentMethod  String?
  paymentDetails String?
  referenceDate  DateTime?      @db.Date
  rawStatus      String?
  status         FinanceStatus  @default(UNSPECIFIED)
  resolved       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, resolved])
  @@index([customerId])
}

model FinanceAttendance {
  id               String          @id @default(uuid()) @db.Uuid
  customerId       String          @db.Uuid
  customer         FinanceCustomer @relation(fields: [customerId], references: [id])
  partnerId        String          @db.Uuid
  partner          Partner         @relation(fields: [partnerId], references: [id])
  catalogItemId    String          @db.Uuid
  catalogItem      CatalogItem     @relation(fields: [catalogItemId], references: [id])
  serviceName      String
  serviceType      String
  fullPriceCents   Int
  chargedCents     Int
  performedAt      DateTime        @default(now())
  registeredById   String          @db.Uuid
  registeredBy     User            @relation(fields: [registeredById], references: [id])
  voidedAt         DateTime?
  voidedById       String?         @db.Uuid
  voidReason       String?
  createdAt        DateTime        @default(now())

  @@index([performedAt, voidedAt])
  @@index([partnerId, performedAt])
  @@index([customerId, performedAt])
}
